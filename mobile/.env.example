# Leave unset in local dev so src/api/client.ts auto-detects:
# - Android emulator -> http://10.0.2.2:8000
# - Web -> http://localhost:8000
# - Physical device -> Metro LAN IP:8000
# EXPO_PUBLIC_API_URL=http://localhost:8000

# Mobile API Key (matches backend MOBILE_API_SECRET if configured)
EXPO_PUBLIC_MOBILE_API_KEY=your_mobile_api_key_here
